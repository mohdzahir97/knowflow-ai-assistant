# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="AI Company Knowledge Assistant"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8001

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Every browser origin allowed to call the API. The Streamlit client calls
# the API server-side and so does not strictly need an entry; the React
# client runs in the browser and does.
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173","http://localhost:5174"]

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/app.db

# ---------------------------------------------------------------------------
# JWT Authentication
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ---------------------------------------------------------------------------
# LLM Providers (only the keys you use need to be set)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Ollama runs locally and needs no API key — just the server base URL.
# Inside Docker Compose, use http://host.docker.internal:11434 to reach an
# Ollama instance running on the host machine.
OLLAMA_BASE_URL=http://localhost:11434

DEFAULT_CHAT_PROVIDER=openai
DEFAULT_CHAT_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_PROVIDER=openai
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_REQUEST_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Observability (LangSmith)
# ---------------------------------------------------------------------------
# LangSmith is a HOSTED service - enabling this sends run data off this
# machine. LANGSMITH_REDACT_CONTENT=true (the default) strips question text,
# retrieved document text and generated answers before anything is sent,
# keeping only timings, token counts, providers and run structure.
# Set it to false only when tracing against non-sensitive test fixtures.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-company-knowledge-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_REDACT_CONTENT=true

# ---------------------------------------------------------------------------
# RAG / Chunking / Retrieval
# ---------------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=4

# --- AI guardrails ---------------------------------------------------------
# Pattern-based input/output checks. These are ONE layer: the structural
# protections in prompt_builder (nonce-delimited untrusted context,
# neutralised source markers, structured history) are what actually contain a
# malicious document, and they cannot be turned off.
GUARDRAILS_ENABLED=true
GUARDRAIL_MAX_QUESTION_CHARS=2000
GUARDRAIL_REDACT_PII_IN_QUERIES=true
GUARDRAIL_REDACT_PII_IN_ANSWERS=true

# --- Rate limiting ---------------------------------------------------------
# Counters are in-process: with multiple workers the effective limit is
# multiplied by worker count. Move to Redis before scaling out.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_HOUR=50

# --- Hybrid retrieval ------------------------------------------------------
# Fuses vector similarity with BM25 keyword matching via Reciprocal Rank
# Fusion. Vector search alone misses exact-phrase queries; keyword search
# alone over-rewards short lines (BM25 normalises by document length).
# Combining them is what handles both. The BM25 index is derived from the
# stored chunks and rebuilt automatically whenever documents change.
HYBRID_SEARCH_ENABLED=true
HYBRID_RRF_K=60

# --- Corrective RAG --------------------------------------------------------
# Context grading is score-based (free): Chroma returns 0-1 relevance scores
# with results, so no extra LLM call is needed to judge context quality.
# Measured with nomic-embed-text: on-topic ~0.34-0.50, off-topic ~0.10-0.22.
# Score scales differ per embedding model, so re-tune if you change models.
CRAG_ENABLED=true
CRAG_RELEVANCE_THRESHOLD=0.25
CRAG_MIN_RELEVANT_CHUNKS=1
# Each correction round = one LLM rewrite + one retrieval. Only runs when
# grading judges the context poor, so good questions cost nothing extra.
CRAG_MAX_CORRECTION_ATTEMPTS=1
# Verifying groundedness costs one extra LLM call per ANSWERED question
# (skipped when the assistant declines). Roughly doubles latency on local
# models, so it is off by default.
CRAG_VERIFY_GROUNDEDNESS=false

# OCR fallback for scanned / image-only PDFs (pages with no native text layer).
# Set OCR_ENABLED=false to disable and reject scanned PDFs instead.
OCR_ENABLED=true
OCR_DPI=200

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
UPLOAD_DIR=./data/uploads
CHROMA_PERSIST_DIR=./data/chroma
MAX_UPLOAD_SIZE_MB=25
MAX_REQUEST_BODY_MB=100

# ---------------------------------------------------------------------------
# Email and account recovery
# ---------------------------------------------------------------------------
# "console" writes the message to the log and stdout - password reset and
# email confirmation work end to end with nothing to sign up for. Unsuitable
# for production: the log then contains single-use links.
# "smtp" delivers through the settings below. No third-party email service
# is integrated; any SMTP server will do.
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@example.com

SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Where emailed links point - the frontend, not the API.
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440

# Off by default so turning verification on later never locks out accounts
# that were created before it existed.
REQUIRE_EMAIL_VERIFICATION=false

# ---------------------------------------------------------------------------
# Caching
# ---------------------------------------------------------------------------
# Caches question embeddings in memory, keyed by provider+model+text.
# Embedding the question is the slowest step before an answer can begin, and
# it is a pure function of its input, so a repeat question is served from
# memory. Disable only when profiling cold-path latency.
EMBEDDING_CACHE_ENABLED=true

# ---------------------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------------------
# Adds CSP, X-Frame-Options, X-Content-Type-Options, Referrer-Policy and the
# cross-origin isolation headers to every response. Leave enabled unless you
# are debugging a browser client that they block.
SECURITY_HEADERS_ENABLED=true

# Strict-Transport-Security lifetime. Only ever sent over HTTPS, so this has
# no effect on a local HTTP dev server. One year = preload-eligible.
HSTS_MAX_AGE_SECONDS=31536000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
